# apps/shelf/web の環境変数の雛形
#
# - ローカル開発:  このファイルを .env にコピーして値を埋める
# - 本番デプロイ:  .env.production にコピーして本番の値を埋める
#
# 重要: Cloudflare Pages は Git 連携なしの手動デプロイ（mise run shelf:deploy:web）なので、
# 本番の値は手元の vite build 時に bundle へ焼き込まれる。
# Pages ダッシュボードの環境変数は手元のビルドには注入されないため、
# .env.production が無い/localhost を指したままだと localhost 向けの本番サイトを公開してしまう。
# これを防ぐため vite.config.ts が production ビルド時に値を検証して落とす。

VITE_API_URL=https://todo-shelf-api.example.workers.dev
VITE_API_SECRET=
VITE_TODO_APP_API_URL=https://todo-app-api.example.workers.dev
